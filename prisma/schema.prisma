generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model achievement_categories {
  id                        String                      @id
  name                      String                      @unique
  achievement_category_maps achievement_category_maps[]
}

model achievement_category_maps {
  achievement_id         String
  category_id            String
  achievements           achievements           @relation(fields: [achievement_id], references: [id], onDelete: Cascade)
  achievement_categories achievement_categories @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@id([achievement_id, category_id])
}

model achievements {
  id                        String                      @id
  title                     String
  description               String?
  achieved_at               DateTime                    @db.Date
  created_at                DateTime                    @default(now())
  updated_at                DateTime                    @default(now())
  achievement_category_maps achievement_category_maps[]
}

model backgrounds {
  id          String   @id
  title       String
  description String?
  event_date  DateTime @db.Date
  created_at  DateTime @default(now())
}

model blogs {
  id            String   @id
  title         String
  content       String
  thumbnail_url String?
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now())
}

model project_details {
  project_id String   @id
  background String
  key_points String
  challenges String
  solutions  String
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  projects   projects @relation(fields: [project_id], references: [id], onDelete: Cascade)
}

model project_skill_maps {
  project_id String
  skill_id   String
  projects   projects @relation(fields: [project_id], references: [id], onDelete: Cascade)
  skills     skills   @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@id([project_id, skill_id])
}

model projects {
  id                 String               @id
  title              String
  description        String
  thumbnail_url      String?
  repo_url           String?
  demo_url           String?
  is_featured        Boolean              @default(false)
  created_at         DateTime             @default(now())
  updated_at         DateTime             @default(now())
  project_details    project_details?
  project_skill_maps project_skill_maps[]
}

model skill_tech_category_maps {
  skill_id        String
  category_id     String
  tech_categories tech_categories @relation(fields: [category_id], references: [id], onDelete: Cascade)
  skills          skills          @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@id([skill_id, category_id])
}

model skills {
  id                       String                     @id
  name                     String
  level                    Int                        @db.SmallInt
  description              String?
  created_at               DateTime                   @default(now())
  updated_at               DateTime                   @default(now())
  project_skill_maps       project_skill_maps[]
  skill_tech_category_maps skill_tech_category_maps[]
}

model tech_categories {
  id                       String                     @id
  name                     String                     @unique
  skill_tech_category_maps skill_tech_category_maps[]
}
